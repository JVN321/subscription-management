{
  "name": "subscription-management-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @repo/api --filter @repo/web dev",
    "build": "pnpm --filter @repo/web build",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "db:seed": "pnpm --filter @repo/db db:seed",
    "db:studio": "pnpm --filter @repo/db db:studio",
    "test": "pnpm --filter @repo/domain test && pnpm --filter @repo/db test && pnpm --filter @repo/api test && pnpm --filter @repo/web test",
    "test:e2e": "pnpm --filter @repo/web test:e2e",
    "test:all": "pnpm test && pnpm test:e2e",
    "typecheck": "pnpm --recursive exec tsc --noEmit",
    "docker:up": "docker compose -f docker-compose.dev.yml up -d postgres redis",
    "docker:down": "docker compose -f docker-compose.dev.yml down"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
